---
export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Architect as a Service — Enterprise Architecture Intelligence',
	description = 'The enterprise-grade AI platform that answers every architecture question with complete, unwavering confidence.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#05060a" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background: #05060a;
		color: #e8ecf5;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue',
			Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		overflow-x: hidden;
	}

	::selection {
		background: rgba(99, 102, 241, 0.35);
	}
</style>
